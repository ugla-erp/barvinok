{
  "name": "barvinok",
  "version": "0.1.0",
  "description": "Ukrainian national EC cryptography (DSTU-4145) implementaion",
  "type": "module",
  "main": "dist/index.cjs",
  "browser": {
    "./lib/rand.js": "./lib/rand.browser.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsdown lib/index.js -f cjs -f esm --clean --platform node --target es2015 --deps.never-bundle barvinok-asn1 --deps.never-bundle js-lzma --deps.never-bundle barvinok-keystore --deps.never-bundle barvinok-gost89 --deps.never-bundle bn.js --deps.never-bundle buffer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugla-erp/barvinok.git",
    "directory": "packages/core"
  },
  "keywords": [
    "ecc",
    "cryptography",
    "dstu4145",
    "ukraine"
  ],
  "author": "Ilya Petrov",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ugla-erp/barvinok/issues"
  },
  "homepage": "https://github.com/ugla-erp/barvinok/tree/main/packages/core#readme",
  "devDependencies": {
    "barvinok-gost89": "0.1.0",
    "tsdown": "^0.22.7"
  },
  "dependencies": {
    "barvinok-asn1": "0.1.0",
    "bn.js": "^5.2.5",
    "buffer": "^5.7.1",
    "barvinok-keystore": "0.1.0",
    "js-lzma": "^0.1.0"
  },
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "lib/",
    "LICENSE",
    "README.md"
  ]
}
